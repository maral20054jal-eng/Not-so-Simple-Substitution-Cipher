def encrypt(n):
    with open("Plaintext.txt", "r") as f:
        plaintext = f.read()

    ciphertext = ""
    for ch in plaintext:
        if ch.isalpha():
            # Check if uppercase
            base = ord('A') if ch.isupper() else ord('a')
            # Shift and wrap around
            shifted = (ord(ch) - base + n) % 26 + base
            ciphertext += chr(shifted)
        else:
            ciphertext += ch

    with open("Ciphertext.txt", "w") as f:
        f.write(ciphertext)
    print(f"Encryption complete. Ciphertext written to Ciphertext.txt")


def decrypt(n):
    with open("Ciphertext.txt", "r") as f:
        ciphertext = f.read()

    plaintext = ""
    for ch in ciphertext:
        if ch.isalpha():
            base = ord('A') if ch.isupper() else ord('a')
            shifted = (ord(ch) - base - n) % 26 + base
            plaintext += chr(shifted)
        else:
            plaintext += ch

    with open("ExactPlaintext.txt", "w") as f:
        f.write(plaintext)
    print(f"Decryption complete. Plaintext written to ExactPlaintext.txt")


def advanced_decrypt():
    with open("Ciphertext.txt", "r") as f:
        ciphertext = f.read()

    # Try all possible shifts
    for n in range(26):
        plaintext = ""
        for ch in ciphertext:
            if ch.isalpha():
                base = ord('A') if ch.isupper() else ord('a')
                shifted = (ord(ch) - base - n) % 26 + base
                plaintext += chr(shifted)
            else:
                plaintext += ch

        # Basic check: if 'the' or 'and' appears in plaintext (simple English heuristic)
        if " the " in plaintext.lower() or " and " in plaintext.lower():
            print(f"Possible key found: {n}")
            print("Decrypted text preview:\n", plaintext[:200])
            # Optionally write to file
            with open("ExactPlaintext.txt", "w") as f:
                f.write(plaintext)
            return n

    print("Failed to automatically determine the key.")
    return None


